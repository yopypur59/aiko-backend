# ==========================================
# LiveKit Cloud / Server Credentials (Required)
# ==========================================
# WebSocket URL for LiveKit server connection (e.g., wss://your-project.livekit.cloud)
LIVEKIT_URL=wss://your-project.livekit.cloud

# API Key and Secret generated from LiveKit Cloud Dashboard
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# AI Model Provider Credentials (Required)
# ==========================================
# Google Gemini API Key (used for Gemini Realtime Model in src/agent.py)
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxx

# ==========================================
# Supabase Integration (Optional - Transcript Logging)
# ==========================================
# Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (Required to insert transcripts into "transcripts" table)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ==========================================
# Web / Token Server Settings (Optional / Railway Defaults)
# ==========================================
# Port for FastAPI Token Server (Railway automatically sets PORT variable)
PORT=8000
HOST=0.0.0.0

